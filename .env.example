APP_NAME=Helpdesk
APP_ENV=local
# Gere com: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8102

# Mostra as contas de demonstração na tela de login.
APP_DEMO=true

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stderr
LOG_LEVEL=info

# SQLite em arquivo: um volume, nenhum serviço extra para manter.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
